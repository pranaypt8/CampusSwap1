# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Port the Express server listens on (Render/Railway set this automatically)
PORT=5000

# Set to "production" when deployed; leave unset/"development" locally
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only needed if frontend and backend are deployed as SEPARATE services
# (used for CORS). Not needed for the single combined-service deploy.
CLIENT_URL=
